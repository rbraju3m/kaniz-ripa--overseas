# Production environment for Kaniz Ripa Overseas.
# Store as /var/www/kaniz-ripa/shared/.env (VPS) or in Forge → Environment. Never commit real values.

APP_NAME="Kaniz Ripa Overseas"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.com
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kaniz_ripa
DB_USERNAME=kaniz_ripa
DB_PASSWORD=                  # long random password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=YOUR-DOMAIN.com
SANCTUM_STATEFUL_DOMAINS=YOUR-DOMAIN.com

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Content-Security-Policy (nonce-based) — on by default in production.
CSP_ENABLED=true

# Company profile PDF generation (headless Chrome, no Node needed).
LARAVEL_PDF_DRIVER=chrome
LARAVEL_PDF_CHROME_BINARY=/usr/bin/google-chrome
LARAVEL_PDF_CHROME_HOME=/var/www/kaniz-ripa/shared/chrome-home
LARAVEL_PDF_CHROME_NO_SANDBOX=false   # see docs/DEPLOYMENT.md before changing

# Mail (contact-message replies are sent from the admin's own mail client;
# this is for backup failure notifications and password resets).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@YOUR-DOMAIN.com"
MAIL_FROM_NAME="${APP_NAME}"

# Backups (database + uploads, daily at 02:00).
BACKUP_NAME=kaniz-ripa-overseas
BACKUP_PATH=/var/www/kaniz-ripa/shared/backups
BACKUP_DISKS=backups          # add ",s3" for an off-site copy (configure AWS_* below)
BACKUP_NOTIFICATION_EMAIL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=

# First deploy only: create the Super Admin with `php artisan db:seed --force`,
# then DELETE these two lines (app:check-deployment fails while ADMIN_PASSWORD is set).
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
